# =====================================================================
# Backup System Runtime Environment Variables
# =====================================================================

# Laptop / Client Configuration
BACKUP_SOURCE="/home"
BACKUP_DESKTOP_HOST="192.168.1.50"
BACKUP_DESKTOP_USER="backup-user"
BACKUP_DESKTOP_PORT="22"
BACKUP_SSH_KEY="$HOME/.ssh/id_ed25519_backup"
BACKUP_SAFETY_MARGIN="0.10"

# Desktop / Storage Configuration
BACKUP_STORAGE_ROOT="/srv/backups"
BACKUP_CATALOG_DB="/srv/backups/backup_catalog.db"

# Python Runtime Behavior
PYTHONUNBUFFERED="1"
PYTHONDONTWRITEBYTECODE="1"